{
  "expo": {
    "name": "Tally",
    "slug": "tally",
    "version": "0.2.0",
    "scheme": "io.codebox.tally",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.codebox.tally",
      "supportsTablet": true
    },
    "android": {
      "package": "io.codebox.tally",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#f6f7f4"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/DMSans.ttf", "./assets/fonts/Manrope.ttf"]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
