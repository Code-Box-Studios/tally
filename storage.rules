rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/attachments/{attachmentId}/content {
      // Protected callables authorize owners and use Admin Cloud Storage.
      // Direct Firebase media reads can mint public download tokens.
      allow read, write: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
